# Copie para .env antes de subir. NFR-13: toda variável lida pela aplicação está aqui.

# Senha do SQL Server no container. Precisa de maiúscula, minúscula, número e símbolo.
SA_PASSWORD=Mundial#2026Dev

# Imagem do banco. O alvo declarado no spine é SQL Server 2022:
#   DB_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
#   DB_USER=mssql
# Em Apple Silicon (arm64) essa imagem só existe para amd64 e quebra sob emulação, então o
# padrão abaixo usa o Azure SQL Edge — mesmo motor, imagem ARM64 nativa. O schema e o SQL
# são idênticos; muda apenas a imagem.
DB_IMAGE=mcr.microsoft.com/azure-sql-edge:latest
DB_USER=root

# String de conexão usada pela API e pelas migrations.
# Os serviços se referenciam por NOME (db), nunca por localhost.
CONNECTION_STRING=Server=db,1433;Database=sgm;User Id=sa;Password=Mundial#2026Dev;TrustServerCertificate=true;Encrypt=false

# AD-7: chave de assinatura do JWT. Em produção vem do cofre de segredos, nunca do repositório.
JWT_SEGREDO=troque-esta-chave-em-producao-com-pelo-menos-32-caracteres

# Validade da sessão em minutos. O legado encerra por inatividade após horas (FR-54).
SESSAO_MINUTOS=480

# AD-21: liga o andaime de demonstração — seed, reset e painel de códigos.
# Em produção isto é false, e o projeto Mundial.Demo pode ser removido por completo.
MODO_DEMO=true

# Origem do frontend. O CORS da API libera apenas esta.
# Aceita mais de uma origem, separadas por vírgula. A segunda serve à captura de telas,
# que roda dentro da rede do compose e enxerga o frontend como http://web:3000.
ORIGEM_WEB=http://localhost:3000,http://web:3000

# Porta da API no host. 5000 costuma estar ocupada no macOS pelo AirPlay Receiver.
PORTA_API=5001

# URL da API que o navegador usa. Injetada no index.html na subida do container web.
API_URL=http://localhost:5001

# AD-19: fuso de exibição. O banco e a API trabalham sempre em UTC.
TZ_APLICACAO=America/Sao_Paulo

# Spec OpenAPI em /api/openapi/v1.json e Swagger UI em /api/docs.
# Ligados por padrão; qualquer valor diferente de false mantém ligado.
DOCS_ABERTOS=true

# --- Observabilidade (OpenTelemetry → SigNoz) ---
# Deixe OTEL_EXPORTER_OTLP_ENDPOINT vazio e nada é instrumentado: a POC sobe igual sem coletor.
# Os nomes abaixo são os do padrão OTEL, lidos pelo próprio SDK — não há nome inventado.
#
# Base do coletor, SEM o /v1/... no fim: o SDK acrescenta /v1/traces, /v1/metrics e /v1/logs.
# Este repositório é público: o endereço real do coletor fica no .env, não aqui.
OTEL_EXPORTER_OTLP_ENDPOINT=https://SEU-COLETOR-OTLP

# Este ingest fala OTLP sobre HTTP. Com grpc a exportação falha em silêncio.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Credencial do coletor. Formato é chave=valor separado por vírgula; o espaço depois de
# "Bearer" é literal — não escreva %20, que nem todo SDK desescapa.
# Segredo: o valor real mora só no .env (fora do git) e em /opt/mundial/.env na máquina.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer COLE-O-TOKEN-AQUI

# Nome do serviço na tela do SigNoz.
OTEL_SERVICE_NAME=mundial-api

# Separa POC, homologação e produção no mesmo coletor.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=poc

# Telemetria do navegador: traces (carregamento, chamadas à API, cliques, troca de rota),
# métricas (Web Vitals, erros) e logs. Ligada, o Angular manda tudo para /otlp na PRÓPRIA
# origem, e o nginx do container web repassa ao coletor pondo o Authorization. É assim porque o
# ingest recusa preflight CORS e porque o token não pode viver no JavaScript.
OTEL_WEB=true

# Estas duas têm valor embutido no docker-compose.yml e só precisam vir para cá se você quiser
# outro. Ficam fora do .env da máquina de propósito: chave que falte lá não pode desligar
# recurso — foi assim que a telemetria inteira ficou desligada em produção.
#
#   OTEL_METRICS_EXEMPLAR_FILTER=trace_based
#     Liga o ponto do histograma ao trace que o produziu: clicar no pico de latência
#     abre o request lento. always_off desliga.
#
#   OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
#     O SigNoz guarda contador em delta; em cumulativo todo restart zera a série.

# service.version da telemetria, em API, migrações e navegador. Vem do build, não daqui: o
# deploy passa o commit em --build-arg VERSAO. Neste arquivo só para desenvolvimento, e o
# padrão quando ausente é "dev".
# VERSAO=dev

# AD-14: integração com o ERP externo, desligada no POC.
INTEGRACAO_ESTOQUE_EXTERNO=false
