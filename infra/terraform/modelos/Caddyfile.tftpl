# Proxy reverso da POC. Tudo na mesma origem — sem CORS, um só lugar para o TLS.
#
# Endereço: ${endereco}
# ${nota_tls}

${endereco} {
	encode zstd gzip

	# Estado do último deploy. É por aqui que o pipeline do GitHub confirma
	# qual commit está no ar, sem precisar de acesso SSH à máquina.
	handle /deploy.json {
		root * /srv/publico
		file_server
		header Cache-Control "no-store"
	}

	# Sem strip do prefixo: as rotas da API já nascem com /api
	# (/api/saude, /api/entrar, /api/conferencia, /api/docas…).
	handle /api/* {
		reverse_proxy api:5000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
